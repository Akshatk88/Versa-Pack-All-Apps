    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#FF1F6B"
        android:centerColor="#FF7A2F"
        android:endColor="#FFB300" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp" />
</shape>
